# Copy to .env and change the values.
POSTGRES_USER=daybook
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=daybook
SECRET_KEY=change-me-to-a-long-random-string
# Set only for the first start to create the demo logins (admin/direktor/...); remove afterwards.
SEED_DEMO_USERS=true
# The first administrator (created on start when there are no users yet). Change the password after logging in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# --- AI (optional). Get a key at https://console.anthropic.com. It stays on the server and is never sent to the browser.
# Without it the AI chat and the document drafting are off; signals, reports and the rule-based briefing still work.
ANTHROPIC_API_KEY=
# Or use Google Gemini instead (either key is enough; if both are set Anthropic wins unless AI_PROVIDER is set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_PROVIDER=auto
AI_MODEL=claude-sonnet-5-5
# One sentence about the business, added to the AI prompts (optional).
AI_COMPANY=

# --- Telegram bot (optional). Create a bot with @BotFather, paste its token here (server only, never in the browser), then
# run: docker compose --profile telegram up -d   Users link their chat in the web app: Security -> Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALERT_MINUTES=30
TELEGRAM_DIGEST_HOUR=18      # default daily summary hour for new chats (each person can change it in the bot)
TELEGRAM_UTC_OFFSET=5        # local time = UTC + 5 (Uzbekistan)
# --- Security
# Roles that MUST turn on two-factor login before they can use the system (comma separated), e.g. admin,direktor
REQUIRE_2FA_ROLES=
# --- Backups (docs/security.md)
# Set a long passphrase to encrypt every backup file (AES-256). KEEP IT SAFE: without it the backups cannot be opened.
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=14
BACKUP_EVERY_HOURS=6
# --- HTTPS (optional): your domain; then run "docker compose --profile https up -d" and set the two lines below
DOMAIN=
API_BIND=0.0.0.0
# Port on the host for direct access (Caddy talks to the app inside Docker and does not need it). Change it if 8000 is taken.
API_PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1

# A payment cannot take a bank account below zero. Set to true only if you work with an overdraft.
BANK_ALLOW_NEGATIVE=false
